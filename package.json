{
  "name": "the-temples",
  "private": true,
  "version": "0.1.0",
  "description": "The Temples · សាងប្រាសាទ — TikTok LIVE interactive temple-building game",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n bridge,game,host -c yellow,cyan,magenta \"npm:dev -w @temples/bridge\" \"npm:dev -w @temples/game\" \"npm:dev -w @temples/host\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "e2e": "playwright test",
    "desktop": "npm run start -w @temples/desktop",
    "stream": "npm run build -w @temples/game -w @temples/host && concurrently -k -n bridge,window -c yellow,cyan \"npm:start -w @temples/bridge\" \"npm:start:built -w @temples/desktop\"",
    "coverage": "vitest run --coverage",
    "android": "npm run sync -w @temples/android",
    "android:open": "npm run open -w @temples/android",
    "ipad": "npm run ipad -w @temples/game"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.2",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.3",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "electron": true
  }
}
